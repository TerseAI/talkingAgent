OPENAI_API_KEY=
PORT=3000
# Local by default. For a remote deployment, set HOST and APP_ORIGIN explicitly.
HOST=127.0.0.1
# Leave unset to accept localhost and 127.0.0.1 at the chosen PORT.
# APP_ORIGIN=http://localhost:3000
# Every web host must use the same object ID and SDK --data-dir.
COUNTER_ID=voice-count-to-100
DURABLE_OBJECT_BINARY=/absolute/path/to/little-durable-objects/target/debug/little-durable-objects
